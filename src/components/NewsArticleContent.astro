---
import NewsArticleBody from "./NewsArticleBody.astro";

type ChapterRef = {
  id?: string;
};

type BodyBlock = {
  type?: string;
  text?: string;
  src?: string;
  alt?: string;
  caption?: string;
};

type ArticleData = {
  img?: string;
  title?: string;
  excerpt?: string;
  category?: string;
  author?: string;
};

const {
  article,
  formattedPublishedAt = "",
  bodyBlocks = [],
  chapterByBlockIndex = new Map(),
} = Astro.props as {
  article: ArticleData;
  formattedPublishedAt?: string;
  bodyBlocks?: BodyBlock[];
  chapterByBlockIndex?: Map<number, ChapterRef>;
};
---

<article class="md:col-start-1 md:row-start-2" data-panel="article">
  {
    article.img ? (
      <div class="relative mb-2">
        <img
          src={article.img}
          alt={article.title}
          class="w-full rounded-4xl object-cover min-h-[280px] md:min-h-[420px]"
        />
        <div class="absolute inset-0 rounded-4xl bg-gradient-to-t from-black/90 via-black/45 to-transparent" />
        <div class="absolute bottom-5 left-5 md:left-20 right-5 md:right-20 p-6 md:p-10 bg-background md:bg-transparent rounded-4xl">
          <h1 class="font-heading text-xs md:text-xl mb-3">{article.title}</h1>
          <h2 class="font-body text-xs md:text-xl text-white/90">
            {article.excerpt}
          </h2>
        </div>
      </div>
    ) : (
      <div class="mb-2">
        <h1 class="font-heading text-xl mb-3">{article.title}</h1>
        <h2 class="font-body text-xl text-white/90">{article.excerpt}</h2>
      </div>
    )
  }

  <p class="text-xs uppercase tracking-wide text-text/70 mb-10 md:ml-20">
    {article.category} • {article.author}
    {formattedPublishedAt && ` • ${formattedPublishedAt}`}
  </p>

  <NewsArticleBody
    bodyBlocks={bodyBlocks}
    chapterByBlockIndex={chapterByBlockIndex}
  />
</article>
