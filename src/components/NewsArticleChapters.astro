---
type ChapterItem = {
  id: string;
  title: string;
};

const { chapterItems = [] } = Astro.props as {
  chapterItems?: ChapterItem[];
};
---

<aside
  class="md:col-start-2 md:row-start-2 mb-10 md:mb-0"
  data-panel="chapters"
>
  <h3 class="font-heading text-2xl text-center md:text-right mb-4 md:mr-12">
    Chapters
  </h3>

  {
    chapterItems.length ? (
      <ul class="flex flex-col gap-3 items-center md:items-end md:mr-12">
        {chapterItems.map((chapter) => (
          <li class="text-center md:text-right">
            <a
              href={`#${chapter.id}`}
              data-chapter-link
              class="font-body text-base text-text/85 hover:text-text transition-colors"
            >
              {chapter.title}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="font-body text-sm text-text/65">No chapters available.</p>
    )
  }
</aside>
