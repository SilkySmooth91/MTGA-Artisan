---
type ChapterRef = {
  id?: string;
};

type BodyBlock = {
  type?: string;
  text?: string;
  src?: string;
  alt?: string;
  caption?: string;
  style?: string;
};

const { bodyBlocks = [], chapterByBlockIndex = new Map() } = Astro.props as {
  bodyBlocks?: BodyBlock[];
  chapterByBlockIndex?: Map<number, ChapterRef>;
};

const URL_REGEX = /https?:\/\/[^\s]+/g;

// Splits paragraph text into plain-text and URL segments so links render as real <a> tags.
function linkifyText(text: string = "") {
  const segments: { text?: string; url?: string }[] = [];
  let lastIndex = 0;
  let match: RegExpExecArray | null;

  URL_REGEX.lastIndex = 0;
  while ((match = URL_REGEX.exec(text)) !== null) {
    if (match.index > lastIndex) {
      segments.push({ text: text.slice(lastIndex, match.index) });
    }
    segments.push({ url: match[0] });
    lastIndex = match.index + match[0].length;
  }

  if (lastIndex < text.length) {
    segments.push({ text: text.slice(lastIndex) });
  }

  return segments;
}
---

<section class="space-y-6 md:mx-20 font-body text-base md:text-lg">
  {
    bodyBlocks.map((block, blockIndex) => {
      if (!block || typeof block !== "object") return null;

      if (block.type === "h2" || block.type === "h3" || block.type === "h4") {
        const chapter = chapterByBlockIndex.get(blockIndex);

        return (
          <h3 id={chapter?.id} class="font-heading text-2xl mt-6 scroll-mt-28">
            {block.text}
          </h3>
        );
      }

      if (block.type === "paragraph") {
        const segments = linkifyText(block.text || "");
        const isItalic = block.style === "italic";

        return (
          <p class={`whitespace-pre-line${isItalic ? " italic" : ""}`}>
            {segments.map((segment) =>
              segment.url ? (
                <a
                  href={segment.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary underline break-all"
                >
                  {segment.url}
                </a>
              ) : (
                segment.text
              ),
            )}
          </p>
        );
      }

      if (block.type === "image") {
        return (
          <figure class="my-8">
            <img
              src={block.src}
              alt={block.alt || ""}
              class="w-full rounded-xl"
            />
            {block.caption && (
              <figcaption class="text-sm text-text/70 mt-2">
                {block.caption}
              </figcaption>
            )}
          </figure>
        );
      }

      return null;
    })
  }
</section>
