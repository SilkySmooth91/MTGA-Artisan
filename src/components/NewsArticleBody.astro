---
type ChapterRef = {
  id?: string;
};

type BodyBlock = {
  type?: string;
  text?: string;
  src?: string;
  alt?: string;
  caption?: string;
  style?: string;
  title?: string;
  content?: string;
  href?: string;
  width?: number;
  height?: number;
  headers?: string[];
  rows?: string[][];
};

const { bodyBlocks = [], chapterByBlockIndex = new Map() } = Astro.props as {
  bodyBlocks?: BodyBlock[];
  chapterByBlockIndex?: Map<number, ChapterRef>;
};

const URL_REGEX = /https?:\/\/[^\s]+/g;
const INLINE_TAG_REGEX = /<(\/?)(strong|em)>|<a href="([^"]+)">|<\/a>/g;

// Splits plain text into plain-text and URL segments so links render as real <a> tags.
function linkifyText(text: string = "") {
  const segments: { text?: string; url?: string }[] = [];
  let lastIndex = 0;
  let match: RegExpExecArray | null;

  URL_REGEX.lastIndex = 0;
  while ((match = URL_REGEX.exec(text)) !== null) {
    if (match.index > lastIndex) {
      segments.push({ text: text.slice(lastIndex, match.index) });
    }
    segments.push({ url: match[0] });
    lastIndex = match.index + match[0].length;
  }

  if (lastIndex < text.length) {
    segments.push({ text: text.slice(lastIndex) });
  }

  return segments;
}

// Splits paragraph text into parts carrying bold/italic/link state (via <strong>, <em> and <a href="..."> tags, nesting allowed) then linkifies each part.
function parseInlineText(text: string = "") {
  const parts: {
    bold: boolean;
    italic: boolean;
    href?: string;
    segments: { text?: string; url?: string }[];
  }[] = [];
  let bold = false;
  let italic = false;
  let href: string | undefined;
  let lastIndex = 0;
  let match: RegExpExecArray | null;

  const pushChunk = (chunk: string) => {
    if (chunk.length === 0) return;
    parts.push({
      bold,
      italic,
      href,
      segments: href ? [{ text: chunk }] : linkifyText(chunk),
    });
  };

  INLINE_TAG_REGEX.lastIndex = 0;
  while ((match = INLINE_TAG_REGEX.exec(text)) !== null) {
    pushChunk(text.slice(lastIndex, match.index));
    if (match[2]) {
      const isOpening = match[1] !== "/";
      if (match[2] === "strong") bold = isOpening;
      else italic = isOpening;
    } else {
      href = match[3];
    }
    lastIndex = match.index + match[0].length;
  }
  pushChunk(text.slice(lastIndex));

  return parts;
}
---

<section class="space-y-6 md:mx-20 font-body text-base md:text-lg">
  {
    bodyBlocks.map((block, blockIndex) => {
      if (!block || typeof block !== "object") return null;

      if (
        block.type === "h1" ||
        block.type === "h2" ||
        block.type === "h3" ||
        block.type === "h4"
      ) {
        const chapter = chapterByBlockIndex.get(blockIndex);

        return (
          <h3 id={chapter?.id} class="font-heading text-2xl mt-6 scroll-mt-28">
            {block.text}
          </h3>
        );
      }

      if (block.type === "paragraph") {
        const parts = parseInlineText(block.text || "");
        const isItalic = block.style === "italic";

        return (
          <p class={`whitespace-pre-line${isItalic ? " italic" : ""}`}>
            {parts.map((part) =>
              part.segments.map((segment) => {
                const content =
                  segment.url ?
                    <a
                      href={segment.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary underline break-all"
                    >
                      {segment.url}
                    </a>
                  : segment.text;
                const linked =
                  part.href ?
                    <a
                      href={part.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary underline"
                    >
                      {content}
                    </a>
                  : content;
                const italicContent = part.italic ? <em>{linked}</em> : linked;
                return part.bold ? <strong>{italicContent}</strong> : italicContent;
              }),
            )}
          </p>
        );
      }

      if (block.type === "decklist") {
        return (
          <details class="my-6 rounded-xl border border-primary/30 bg-background/50 p-4 open:pb-5">
            <summary class="cursor-pointer font-heading text-lg font-semibold">
              {block.title || "Decklist"}
            </summary>
            <div class="mt-3 whitespace-pre-line text-sm text-text/80">
              {block.content || "Decklist coming soon."}
            </div>
          </details>
        );
      }

      if (block.type === "table") {
        const headers = block.headers || [];
        const rows = block.rows || [];

        return (
          <div class="my-6 overflow-x-auto rounded-xl border border-primary/30">
            <table class="w-full border-collapse text-sm md:text-base">
              {headers.length > 0 && (
                <thead>
                  <tr class="bg-primary/20">
                    {headers.map((header) => (
                      <th class="px-4 py-2 text-left font-heading font-semibold">
                        {header}
                      </th>
                    ))}
                  </tr>
                </thead>
              )}
              <tbody>
                {rows.map((row, rowIndex) => (
                  <tr
                    class={
                      rowIndex % 2 === 0 ?
                        "bg-background/40"
                      : "bg-background/20"
                    }
                  >
                    {row.map((cell) => (
                      <td class="px-4 py-2 text-text/80">{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        );
      }

      if (block.type === "link") {
        return (
          <p>
            <a
              href={block.href || "#"}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary underline font-semibold"
            >
              {block.text} →
            </a>
          </p>
        );
      }

      if (block.type === "image") {
        // Defaults to a Magic card's proportions (63:88) at a card-sized width; override per block via width/height.
        const imgWidth = block.width || 224;
        const imgHeight = block.height;

        return (
          <figure class="my-8 flex flex-col items-center">
            <img
              src={block.src}
              alt={block.alt || ""}
              style={{
                maxWidth: `${imgWidth}px`,
                aspectRatio:
                  imgHeight ? `${imgWidth} / ${imgHeight}` : undefined,
              }}
              class={`w-full h-auto ${imgHeight ? "" : "aspect-63/88"} object-cover rounded-xl mx-auto`}
            />
            {block.caption && (
              <figcaption class="text-sm text-text/70 mt-2 text-center">
                {block.href ?
                  <a
                    href={block.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary underline"
                  >
                    {block.caption}
                  </a>
                : block.caption}
              </figcaption>
            )}
          </figure>
        );
      }

      return null;
    })
  }
</section>
