---
import BigButtonsSection from "../components/BigButtonsSection.astro";
import CallToAction from "../components/CallToAction.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Navbar from "../components/Navbar.astro";
import NewsSection from "../components/NewsSection.astro";
import Layout from "../layouts/Layout.astro";
import { getArticles } from "../lib/articles.js";

const homeNews = await getArticles({ limit: 3 });
---

<Layout
  title="MTGA Artisan | Tornei e community per il formato Artisan su MTGA"
  description="MTGA Artisan — tornei, notizie e community per il formato Artisan su Magic: The Gathering Arena."
>
  <Navbar />
  <Hero />
  <BigButtonsSection />
  <NewsSection articles={homeNews} />
  <CallToAction />
  <Footer />
</Layout>
