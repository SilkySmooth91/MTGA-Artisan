---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import aboutPageHero from "../assets/hero_logo.webp";
import AboutCardSection from "../components/AboutCardSection.astro";
import CallToAction from "../components/CallToAction.astro";
---

<Layout
  title="Chi siamo | MTGA Artisan"
  description="Scopri la missione e la community di MTGA Artisan, il punto di riferimento per il formato Artisan su Magic: The Gathering Arena."
>
  <Navbar />
  <div
    class="w-full max-w-screen-2xl mx-auto px-10 flex items-center justify-center my-24"
  >
    <img
      src={aboutPageHero.src}
      alt="About MTGA Artisan"
      width={720}
      height={553}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <AboutCardSection />
  <CallToAction />
  <Footer />
</Layout>
