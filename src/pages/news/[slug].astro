---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CallToAction from "../../components/CallToAction.astro";
import { getArticleBySlug, getArticles } from "../../lib/articles.js";
import heroLogo from "../../assets/hero_logo.webp";

export async function getStaticPaths() {
  const cards = await getArticles();

  return cards
    .map((card) => {
      const href = card?.href ?? "";
      if (!href.startsWith("/news/")) return null;

      return {
        params: {
          slug: href.slice("/news/".length),
        },
      };
    })
    .filter(Boolean);
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug);

if (!article) {
  return Astro.redirect("/news");
}

const bodyBlocks = Array.isArray(article.body) ? article.body : [];
---

<Layout>
  <Navbar />

  <main class="max-w-5xl mx-auto px-6 mt-20 mb-20 text-text">
    <div class="flex justify-end mb-8">
      <img
        src={heroLogo.src}
        alt="MTGA Artisan Logo"
        class="w-auto h-[140px] md:h-[200px]"
      />
    </div>

    <p class="text-sm uppercase tracking-wide text-text/70 mb-4">
      {article.category} • {article.author}
    </p>

    {
      article.img ? (
        <div class="relative mb-10">
          <img
            src={article.img}
            alt={article.title}
            class="w-full rounded-2xl object-cover min-h-[280px] md:min-h-[420px]"
          />
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-t from-black/90 via-black/45 to-transparent" />
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10">
            <h1 class="font-heading text-3xl md:text-5xl mb-3">
              {article.title}
            </h1>
            <h2 class="font-heading text-xl md:text-2xl text-white/90">
              {article.excerpt}
            </h2>
          </div>
        </div>
      ) : (
        <div class="mb-10">
          <h1 class="font-heading text-4xl md:text-6xl mb-3">
            {article.title}
          </h1>
          <h2 class="font-heading text-2xl md:text-3xl text-white/90">
            {article.excerpt}
          </h2>
        </div>
      )
    }

    <section class="space-y-6 font-body leading-relaxed text-base md:text-lg">
      {
        bodyBlocks.map((block) => {
          if (!block || typeof block !== "object") return null;

          if (
            block.type === "h2" ||
            block.type === "h3" ||
            block.type === "h4"
          ) {
            return <h3 class="font-heading text-2xl mt-6">{block.text}</h3>;
          }

          if (block.type === "paragraph") {
            return <p>{block.text}</p>;
          }

          if (block.type === "image") {
            return (
              <figure class="my-8">
                <img
                  src={block.src}
                  alt={block.alt || ""}
                  class="w-full rounded-xl"
                />
                {block.caption && (
                  <figcaption class="text-sm text-text/70 mt-2">
                    {block.caption}
                  </figcaption>
                )}
              </figure>
            );
          }

          return null;
        })
      }
    </section>
  </main>

  <CallToAction />
  <Footer />
</Layout>
