---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CallToAction from "../../components/CallToAction.astro";
import NewsArticleContent from "../../components/NewsArticleContent.astro";
import NewsArticleChapters from "../../components/NewsArticleChapters.astro";
import NewsArticleTabs from "../../components/NewsArticleTabs.astro";
import { getArticleBySlug, getArticles } from "../../lib/articles.js";
import { prepareArticleContentData } from "../../lib/newsArticlePage.js";
import heroLogo from "../../assets/hero_logo.webp";
import "../../styles/news-article-slug.css";

export async function getStaticPaths() {
  const cards = await getArticles();

  return cards
    .map((card) => {
      const href = card?.href ?? "";
      if (!href.startsWith("/news/")) return null;

      return {
        params: {
          slug: href.slice("/news/".length),
        },
      };
    })
    .filter(Boolean);
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug);

if (!article) {
  return Astro.redirect("/news");
}

const { bodyBlocks, chapterItems, chapterByBlockIndex, formattedPublishedAt } =
  prepareArticleContentData(article);
---

<Layout>
  <Navbar />

  <main
    class="max-w-7xl mx-auto px-6 mt-6 md:mt-20 mb-20 text-text"
    data-article-view="article"
  >
    <div
      class="md:grid md:grid-cols-[minmax(0,1fr)_300px] md:gap-2 md:items-start"
    >
      <div
        class="flex justify-center md:justify-end mb-8 md:mb-10 md:col-start-2 md:row-start-1"
      >
        <img
          src={heroLogo.src}
          alt="MTGA Artisan Logo"
          width={350}
          height={246}
          class="w-auto h-auto"
        />
      </div>

      <NewsArticleTabs />

      <NewsArticleContent
        article={article}
        formattedPublishedAt={formattedPublishedAt}
        bodyBlocks={bodyBlocks}
        chapterByBlockIndex={chapterByBlockIndex}
      />

      <NewsArticleChapters chapterItems={chapterItems} />
    </div>
  </main>

  <CallToAction />
  <Footer />
</Layout>
<script>
  import { initArticleTabs } from "../../lib/newsArticleTabsClient.js";

  initArticleTabs();
</script>
