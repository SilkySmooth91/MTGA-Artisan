---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CallToAction from "../../components/CallToAction.astro";
import { getArticleBySlug, getArticles } from "../../lib/articles.js";
import heroLogo from "../../assets/hero_logo.webp";

export async function getStaticPaths() {
  const cards = await getArticles();

  return cards
    .map((card) => {
      const href = card?.href ?? "";
      if (!href.startsWith("/news/")) return null;

      return {
        params: {
          slug: href.slice("/news/".length),
        },
      };
    })
    .filter(Boolean);
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug);

if (!article) {
  return Astro.redirect("/news");
}

const bodyBlocks = Array.isArray(article.body) ? article.body : [];

function toAnchorId(text, index) {
  const base = String(text || "")
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-");

  return `${base || "chapter"}-${index + 1}`;
}

const chapterItems = bodyBlocks.reduce((acc, block, blockIndex) => {
  if (!block || typeof block !== "object") return acc;

  if (block.type === "h2" || block.type === "h3" || block.type === "h4") {
    const title = String(block.text || "").trim();
    if (!title) return acc;

    acc.push({
      blockIndex,
      title,
      id: toAnchorId(title, acc.length),
    });
  }

  return acc;
}, []);

const chapterByBlockIndex = new Map(
  chapterItems.map((chapter) => [chapter.blockIndex, chapter]),
);

const formattedPublishedAt = article?.created_at
  ? new Intl.DateTimeFormat("en-GB", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    }).format(new Date(article.created_at))
  : "";
---

<Layout>
  <Navbar />

  <main class="max-w-7xl mx-auto px-6 mt-20 mb-20 text-text">
    <div
      class="md:grid md:grid-cols-[minmax(0,1fr)_300px] md:gap-2 md:items-start"
    >
      <div class="flex justify-end mb-8 md:mb-10 md:col-start-2 md:row-start-1">
        <img src={heroLogo.src} alt="MTGA Artisan Logo" class="w-auto h-auto" />
      </div>

      <article class="md:col-start-1 md:row-start-2">
        {
          article.img ? (
            <div class="relative mb-2">
              <img
                src={article.img}
                alt={article.title}
                class="w-full rounded-4xl object-cover min-h-[280px] md:min-h-[420px]"
              />
              <div class="absolute inset-0 rounded-4xl bg-gradient-to-t from-black/90 via-black/45 to-transparent" />
              <div class="absolute bottom-5 left-20 right-20 p-6 md:p-10 bg-background md:bg-transparent rounded-4xl">
                <h1 class="font-heading text-xl mb-3">{article.title}</h1>
                <h2 class="font-body text-xl text-white/90">
                  {article.excerpt}
                </h2>
              </div>
            </div>
          ) : (
            <div class="mb-2">
              <h1 class="font-heading text-xl mb-3">{article.title}</h1>
              <h2 class="font-body text-xl text-white/90">{article.excerpt}</h2>
            </div>
          )
        }

        <p class="text-xs uppercase tracking-wide text-text/70 mb-10 md:ml-20">
          {article.category} • {article.author}
          {formattedPublishedAt && ` • ${formattedPublishedAt}`}
        </p>

        <section class="space-y-6 md:mx-20 font-body text-base md:text-lg">
          {
            bodyBlocks.map((block, blockIndex) => {
              if (!block || typeof block !== "object") return null;

              if (
                block.type === "h2" ||
                block.type === "h3" ||
                block.type === "h4"
              ) {
                const chapter = chapterByBlockIndex.get(blockIndex);

                return (
                  <h3
                    id={chapter?.id}
                    class="font-heading text-2xl mt-6 scroll-mt-28"
                  >
                    {block.text}
                  </h3>
                );
              }

              if (block.type === "paragraph") {
                return <p>{block.text}</p>;
              }

              if (block.type === "image") {
                return (
                  <figure class="my-8">
                    <img
                      src={block.src}
                      alt={block.alt || ""}
                      class="w-full rounded-xl"
                    />
                    {block.caption && (
                      <figcaption class="text-sm text-text/70 mt-2">
                        {block.caption}
                      </figcaption>
                    )}
                  </figure>
                );
              }

              return null;
            })
          }
        </section>
      </article>

      <aside class="md:col-start-2 md:row-start-2 mb-10 md:mb-0">
        <h3 class="font-heading text-2xl text-right mb-4 md:mr-12">Chapters</h3>

        {
          chapterItems.length ? (
            <ul class="flex flex-col gap-3 md:items-end md:mr-12">
              {chapterItems.map((chapter) => (
                <li>
                  <a
                    href={`#${chapter.id}`}
                    class="font-body text-base text-text/85 hover:text-text transition-colors"
                  >
                    {chapter.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="font-body text-sm text-text/65">No chapters available.</p>
          )
        }
      </aside>
    </div>
  </main>

  <CallToAction />
  <Footer />
</Layout>
