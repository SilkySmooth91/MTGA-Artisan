---
import ArticleList from "../../components/ArticleList.astro";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import TopicsList from "../../components/TopicsList";
import Layout from "../../layouts/Layout.astro";
import TwoColumnsLayout from "../../layouts/TwoColumnsLayout.astro";
import CallToAction from "../../components/CallToAction.astro";
import { getArticles } from "../../lib/articles.js";

const normalize = (value = "") => String(value).trim().toLowerCase();

const allArticles = await getArticles();
const selectedCategory = Astro.url.searchParams.get("category")?.trim() ?? "";

const categoriesFromDb = [
  ...new Set(
    allArticles
      .map((article) => article.category)
      .filter(Boolean)
      .map((category) => category.trim()),
  ),
];

const fallbackTopics = [
  "Draft",
  "Deckbuilding",
  "Metagame",
  "Events",
  "Patch Notes",
];
const topics = categoriesFromDb.length ? categoriesFromDb : fallbackTopics;

const activeTopic =
  topics.find((topic) => normalize(topic) === normalize(selectedCategory)) ||
  topics[0] ||
  "";
---

<Layout
  title="News | MTGA Artisan"
  description="The latest news, guides, and updates on the Artisan format for Magic: The Gathering Arena."
>
  <Navbar />
  <TwoColumnsLayout>
    <ArticleList slot="main" articles={allArticles} />
    <TopicsList
      slot="topic-list"
      topics={topics}
      activeTopic={activeTopic}
      pagePath="/news"
      queryKey="category"
      client:load
    />
  </TwoColumnsLayout>
  <CallToAction />
  <Footer />
</Layout>

<script>
  const normalize = (value: string | null = "") =>
    String(value ?? "")
      .trim()
      .toLowerCase();

  function applyFilter(category: string | null) {
    const target = normalize(category);
    document
      .querySelectorAll<HTMLElement>(".article-list [data-category]")
      .forEach((card) => {
        const matches = !target || normalize(card.dataset.category) === target;
        card.classList.toggle("hidden", !matches);
      });
  }

  applyFilter(new URLSearchParams(window.location.search).get("category"));

  window.addEventListener("articles:filter", (event) => {
    applyFilter(
      (event as CustomEvent<{ category: string }>).detail?.category ?? null,
    );
  });

  window.addEventListener("popstate", () => {
    applyFilter(new URLSearchParams(window.location.search).get("category"));
  });
</script>
