---
import ArticleList from "../../components/ArticleList.astro";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import TopicsList from "../../components/TopicsList";
import Layout from "../../layouts/Layout.astro";
import TwoColumnsLayout from "../../layouts/TwoColumnsLayout.astro";
import CallToAction from "../../components/CallToAction.astro";
import { getArticles } from "../../lib/articles.js";

const normalize = (value = "") => String(value).trim().toLowerCase();

const allArticles = await getArticles();
const selectedCategory = Astro.url.searchParams.get("category")?.trim() ?? "";

const categoriesFromDb = [
  ...new Set(
    allArticles
      .map((article) => article.category)
      .filter(Boolean)
      .map((category) => category.trim()),
  ),
];

const fallbackTopics = [
  "Draft",
  "Deckbuilding",
  "Metagame",
  "Events",
  "Patch Notes",
];
const topics = categoriesFromDb.length ? categoriesFromDb : fallbackTopics;

const activeTopic =
  topics.find((topic) => normalize(topic) === normalize(selectedCategory)) ||
  topics[0] ||
  "";

const filteredArticles = selectedCategory
  ? allArticles.filter(
      (article) => normalize(article.category) === normalize(selectedCategory),
    )
  : allArticles;
---

<Layout
  title="News | MTGA Artisan"
  description="Le ultime notizie, guide e aggiornamenti sul formato Artisan di Magic: The Gathering Arena."
>
  <Navbar />
  <TwoColumnsLayout>
    <ArticleList slot="main" articles={filteredArticles} />
    <TopicsList
      slot="topic-list"
      topics={topics}
      activeTopic={activeTopic}
      pagePath="/news"
      queryKey="category"
      client:load
    />
  </TwoColumnsLayout>
  <CallToAction />
  <Footer />
</Layout>
